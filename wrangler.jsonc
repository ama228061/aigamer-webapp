{
  "name": "agro-assistant",
  "main": "worker.mjs",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "compatibility_date": "2026-10-07",
  "vars": {
    "ALLOWED_ORIGIN": "https://ama228061.github.io",
    "GEMINI_MODEL": "gemini-3.8-flash",
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
