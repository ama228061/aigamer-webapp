{
  "name": "agro-webapp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node --use-env-proxy server.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/agro-worker-build",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
